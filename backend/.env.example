# ==========================================================
#  IGNITE BLOG BACKEND - ENVIRONMENT VARIABLES
#  Bu faylni nusxalab ".env" deb nomlang va qiymatlarni to'ldiring.
#  Buyruq:  cp .env.example .env
#
#  Majburiy: DATABASE_URL, JWT_SECRET. Qolganlari ixtiyoriy —
#  to'ldirilmagan bo'lsa, tegishli imkoniyat shunchaki o'chiq bo'ladi.
#  To'liq ro'yxat va tekshiruv: src/config/env.ts
# ==========================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# CORS uchun ruxsat etilgan originlar (vergul bilan).
# Lokalda ikkita ilova bor: admin panel (3000) va public sayt (3001).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ignite_blog?schema=public"

# --- JWT (Auth) ---
# Maxfiy kalit. Ishlab chiqarishda uzun, tasodifiy qiymat ishlating.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
# Access token muddati (qisqa bo'lgani ma'qul — refresh token uni yangilaydi)
JWT_EXPIRES_IN=7d
# Refresh token muddati (kun)
REFRESH_TOKEN_DAYS=30

# --- Manzillar ---
# Backend'ning o'z ommaviy manzili — OAuth callback shu asosda quriladi.
OAUTH_CALLBACK_BASE=http://localhost:5000
# Public sayt manzili — OAuth'dan keyingi redirect va email havolalari uchun.
FRONTEND_URL=http://localhost:3001

# --- OAuth (ixtiyoriy) ---
# Ikkala kalit ham to'ldirilsa, o'sha provayder avtomatik yoqiladi.
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://discord.com/developers/applications -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Telegram Login Widget (ixtiyoriy) ---
# @BotFather dan bot yarating. Username @ belgisiz yoziladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Email (Resend, ixtiyoriy) ---
# Bo'sh bo'lsa: development'da email matni konsolga chiqadi (havolani
# shu yerdan nusxalasangiz bo'ladi), production'da esa aniq xato beriladi.
# https://resend.com -> API Keys
RESEND_API_KEY=
EMAIL_FROM=Ignite Blog <onboarding@resend.dev>

# --- Cloudinary (media yuklash, ixtiyoriy) ---
# https://cloudinary.com -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=ignite-blog

# --- Birinchi admin (seed script ishlatadi) ---
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@igniteblog.com
ADMIN_PASSWORD=Admin12345!

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
# Yozuv amallari (POST/PUT/PATCH/DELETE) uchun
RATE_LIMIT_MAX=300
# Public GET so'rovlari uchun — kengroq, chunki ular keshlanadi va arzon
RATE_LIMIT_READ_MAX=2000

# Next.js public sayti sahifalarni SERVERDA render qiladi, ya'ni barcha
# o'qish so'rovlari bitta IP'dan keladi va rate limitga birinchi bo'lib
# uriladi. Bu qiymat frontend'dagi INTERNAL_API_TOKEN bilan bir xil bo'lsa,
# o'sha so'rovlar limitdan chiqariladi. Generatsiya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bo'sh qoldirilsa mexanizm o'chiq bo'ladi (lokal dev uchun shart emas).
INTERNAL_API_TOKEN=
