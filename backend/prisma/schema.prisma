// ==========================================================
//  PRISMA SCHEMA - IGNITE BLOG CMS
//  Bu fayl ma'lumotlar bazasi tuzilishini (jadvallar) ta'riflaydi.
//  O'zgartirgandan keyin migratsiya yarating:
//    npm run prisma:migrate -- --name init
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- ENUMS -----------------------------

enum Role {
  SUPER_ADMIN // asosiy admin: userlarni/adminlarni boshqaradi
  ADMIN // yordamchi admin: post + komment moderatsiya + media
  USER // ro'yxatdan o'tgan oddiy foydalanuvchi
}

// Foydalanuvchi qanday usulda ro'yxatdan o'tgan
enum AuthProvider {
  LOCAL
  GOOGLE
  DISCORD
  TELEGRAM
}

// Kontent holati: qoralama yoki chop etilgan
/// Kontent turi. Ilgari uchta alohida jadval bor edi (news/guides/opinions)
/// va ular uchun deyarli bir xil kod uch marta yozilardi. Endi bitta jadval,
/// farq faqat shu maydonda.
enum PostType {
  NEWS
  GUIDE
  OPINION
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

// Qo'llanma murakkabligi
enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Izoh holati: moderatsiya jarayoni
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ----------------------------- USERS -----------------------------

model User {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  password  String? // bcrypt hash (OAuth foydalanuvchilarida bo'lmasligi mumkin)
  role      Role         @default(USER)
  provider  AuthProvider @default(LOCAL)
  avatar    String? // profil rasmi (OAuth'dan yoki yuklangan)
  googleId  String?      @unique
  discordId String?      @unique
  telegramId String?     @unique
  /// OAuth/Telegram orqali kelganlar uchun doim true. Email bilan ro'yxatdan
  /// o'tish olib tashlangani uchun tasdiqlash oqimi endi yo'q, lekin maydon
  /// qoldirildi: kirish mantiqi shunga qaraydi va seed adminni tasdiqlangan
  /// deb belgilaydi.
  emailVerified Boolean  @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Bu foydalanuvchi yaratgan kontentlar
  posts Post[]

  // Foydalanuvchi faoliyati
  comments      Comment[]
  likes         Like[]
  refreshTokens RefreshToken[]
  authCodes     AuthCode[]

  @@index([email])
  @@map("users")
}

// --------------------------- REFRESH TOKENS ----------------------
// Refresh token'lar DB'da saqlanadi (bekor qilish/rotatsiya uchun).

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // token'ning sha256 hash'i (ochiq token saqlanmaydi)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// OAuth'dan qaytishda beriladigan BIR MARTALIK kod.
///
/// Ilgari access va refresh tokenlar to'g'ridan-to'g'ri redirect URL'ining
/// query qismida uzatilardi — ular brauzer tarixida qolar, `Referer`
/// sarlavhasi orqali begona saytga sizib chiqar va server loglariga tushardi.
/// Endi URL'da faqat qisqa muddatli kod ketadi; mijoz uni POST orqali
/// tokenlarga almashtiradi va kod shu zahoti kuyadi.
model AuthCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique // kodning sha256 hash'i
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("auth_codes")
}

// ------------------------------ POSTS ----------------------------

model Post {
  id              String        @id @default(cuid())
  type            PostType
  title           String
  slug            String
  excerpt         String? // qisqacha tavsif (ro'yxatlarda ko'rsatiladi)
  content         String // HTML (Tiptap editordan)
  featuredImage   String? // Cloudinary URL
  metaTitle       String?
  metaDescription String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?

  /// Telegram kanalga yuborilgan vaqt. Bir maqola ikki marta yuborilmasligi
  /// uchun: chop etilgandan keyin tahrirlansa yoki qayta chop etilsa ham
  /// obunachilar bir xil xabarni ikkinchi bor olmaydi.
  telegramPostedAt DateTime?

  /// Faqat GUIDE turi uchun to'ldiriladi.
  difficulty Difficulty?

  // Ro'yxat endpointlari content'ni qaytarmaydi, shuning uchun o'qish
  // vaqti yozish paytida hisoblanadi (utils/readingTime.ts)
  readingMinutes Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories Category[] @relation("PostCategories")
  tags       Tag[]      @relation("PostTags")
  comments   Comment[]
  likes      Like[]

  /// Slug tur ichida unikal: `/news/x` va `/guides/x` bir vaqtda bo'la oladi.
  @@unique([type, slug])
  @@index([type, status, publishedAt])
  @@index([status, publishedAt])
  @@map("posts")
}

// --------------------------- CATEGORIES --------------------------

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts Post[] @relation("PostCategories")

  @@map("categories")
}

// ------------------------------ TAGS -----------------------------

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts Post[] @relation("PostTags")

  @@map("tags")
}

// ---------------------------- COMMENTS ---------------------------

model Comment {
  id          String        @id @default(cuid())
  authorName  String? // ghost (mehmon) uchun; ro'yxatdan o'tganda user'dan olinadi
  authorEmail String? // ghost uchun
  content     String
  status      CommentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  // Ro'yxatdan o'tgan foydalanuvchi (ghost bo'lsa null)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Izoh qaysi maqolaga tegishli
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([postId])
  @@index([userId])
  @@map("comments")
}

// ------------------------------ LIKES ----------------------------
// Har bir foydalanuvchi bitta kontentga faqat bir marta like bosa oladi.

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Like qaysi maqolaga
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Bir user bitta maqolaga faqat bir marta like bosadi
  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("likes")
}


// ---------------------------- RESOURCES --------------------------
// Foydali havolalar to'plami: asboblar, kanallar, saytlar va h.k.
// Maqoladan farqi — bu yerda matn emas, tashqi havola asosiy narsa.

model Resource {
  id          String        @id @default(cuid())
  title       String
  description String? // bir-ikki jumla: nima uchun foydali
  url         String // tashqi havola
  image       String? // Cloudinary URL yoki tashqi rasm
  /// Erkin guruh nomi ("Asboblar", "YouTube kanallar", ...). Ataylab enum
  /// emas: yangi guruh qo'shish uchun migratsiya kerak bo'lmasin.
  group       String?
  status      ContentStatus @default(PUBLISHED)
  /// Qo'lda saralash uchun. Kichik raqam — yuqorida.
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, order])
  @@map("resources")
}

// ----------------------------- MEDIA -----------------------------

model Media {
  id        String   @id @default(cuid())
  publicId  String   @unique // Cloudinary public_id (o'chirish uchun kerak)
  url       String
  width     Int?
  height    Int?
  format    String?
  bytes     Int?
  createdAt DateTime @default(now())

  @@map("media")
}
