# Frontend uchun API manzili (backend).
# Nusxalang:  cp .env.local.example .env.local
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Saytning o'z manzili (SEO/OG uchun; deployda haqiqiy domenni qo'ying)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Telegram Login Widget (BotFather username, @siz)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# Backend'dagi INTERNAL_API_TOKEN bilan AYNAN bir xil qiymat.
# NEXT_PUBLIC_ prefiksi YO'Q — bu maxfiy qiymat va brauzerga tushmasligi kerak.
# Server tomondagi so'rovlarni (SSR/ISR) rate limitdan chiqarish uchun.
INTERNAL_API_TOKEN=
